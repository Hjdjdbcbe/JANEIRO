# real secrets — never commit
.env
.env.*
!.env.example

# supabase CLI local state
.supabase/
supabase/.temp/
supabase/.branches/

# local test harness scratch
tests/local/*.log

node_modules/
.DS_Store

# لوحة التحكم: مفاتيح النشر الحقيقية
dashboard/config.js

# The dashboard test suite writes generated icons here when it runs against
# the local mock storage. The real brand artwork in this folder is committed
# and stays tracked -- git ignores .gitignore for files it already tracks --
# so this rule only keeps the test's leftovers out.
assets/product-media/products/icons/

# the storefront reads its keys the same way the dashboard does
frontend/config.js
