# ============================================================
# Janeiro Store — environment template
# Copy to .env and fill in. NEVER commit the filled .env.
# ============================================================

# ---------- SAFE IN THE BROWSER ----------
# These two go into js/janeiro-api.js. The anon key is public by
# design; RLS is what protects the data.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...YOUR_ANON_KEY

# ---------- SERVER ONLY — NEVER IN FRONTEND ----------
# Set these with:  supabase secrets set KEY=value
# Do not paste them into HTML, JS, or git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...YOUR_SERVICE_ROLE_KEY
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# ---------- بوت المخزون (docs/telegram-bot.md) ----------
# سرّ تخترعه أنت، ويُعطى لتليجرام في setWebhook. الدالة ترفض كل
# تحديث لا يحمله، ولا تعمل أصلاً إن لم يُضبط — لأنها منشورة بلا
# تحقق من JWT، فهذا السر هو كل ما يمنع تحديثاً مزوّراً من تفريغ
# المخزون.  توليده:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# رقمك في تليجرام. صاحبه يصير مالك البوت أول ما يرسل /start،
# وهو السبيل الوحيد لفتح بوت على قاعدة بلا أدمن. (@userinfobot)
TELEGRAM_OWNER_ID=

# دومين المتجر، بلا شرطة في آخره. روابط وثيقة الالتزام تُبنى عليه
# فيرى الزبون janeiro-store لا supabase.co — وvercel.json يحوّل
# /warranty/* إلى الدالة. بلا ضبطه تعمل الروابط بشكل المعاملات،
# فلا يتوقّف شيء إن نُسي.
PUBLIC_SITE_URL=https://your-domain.com

# Lock CORS to your real domain in production
ALLOWED_ORIGIN=https://your-domain.com

# ---------- STORED IN THE DATABASE, NOT HERE ----------
# whatsapp_number  -> store_settings table
# CCP / BaridiMob / Flexy account details -> payment_methods table
# Both are edited from the Supabase dashboard.

# ---------- بوت تفعيل Snapchat+ (docs/activation-bot.md) ----------
# هذي تتحط في متغيرات Vercel (Project → Settings → Environment Variables)،
# ماشي في Supabase. الكليان في واتساب، الأدمين في تيليغرام.

# واتساب (Cloud API، رقم المتجر في وضع Coexistence)
WHATSAPP_TOKEN=                  # System User token دائم من Meta Business
WHATSAPP_PHONE_NUMBER_ID=        # من WhatsApp Manager → API Setup
WHATSAPP_APP_SECRET=             # App → Settings → Basic: يتحقق بيه X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=           # تخترعو أنت، ونفسو في Meta وقت ربط الـwebhook
WHATSAPP_STORE_NUMBER=           # 213XXXXXXXXX — للرابط wa.me (بلاه: whatsapp_number من الإعدادات)
# WHATSAPP_GRAPH_VERSION=v23.0

# تيليغرام (الأدمين برك)
ACTIVATION_BOT_TOKEN=            # من @BotFather
ACTIVATION_WEBHOOK_SECRET=       # openssl rand -hex 32 — نفسو في tools/setup-activation-bot.sh
ADMIN_CHAT_IDS=                  # أرقام تيليغرام تاع الأدمين، بفاصلة (@userinfobot)

# Supabase
# ACTIVATION_SUPABASE_URL=       # اختياري؛ بلاه يستعمل SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY      # (فوق) — لازم تكون في Vercel تاني

# الـAI: موديل واحد للصور، الفوكالات والأجوبة
GEMINI_API_KEY=                  # Google AI Studio، الخطة المدفوعة
AI_MODEL=gemini-3.8-flash
AI_DAILY_BUDGET_USD=5            # كي يوصل، كل الحالات تتحول لمالك حتى غدوة
# AI_THINKING_LEVEL=low          # minimal | low | medium | high ("" = افتراضي الموديل)
# أسعار $ لكل مليون token — لحساب المصروف. بدلهم كي تتبدل أسعار Google.
# AI_PRICE_INPUT_PER_M=0.75
# AI_PRICE_AUDIO_INPUT_PER_M=1.5
# AI_PRICE_OUTPUT_PER_M=3.75
