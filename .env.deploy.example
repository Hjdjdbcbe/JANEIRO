# انسخ هذا الملف إلى .env.deploy وعبّئه. الأصل بلا أسرار، والنسخة
# مستثناة في .gitignore ولا تدخل git أبداً.

# من رابط مشروعك: https://supabase.com/dashboard/project/XXXXXXXX
SUPABASE_PROJECT_REF=

# عنوان متجرك بالضبط، بلا شرطة في آخره. هذا وحده ما تقبله الدوال.
SITE_URL=https://janeiro-store.com

# اختياري — إشعار تيليغرام بكل طلب جديد. اتركهما فارغين إن لم ترده بعد.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- بوت المخزون (docs/telegram-bot.md) ----------
# رقمك في تليجرام. صاحبه يصير مالك البوت أول ما يرسل /start.
# لمعرفته: راسل @userinfobot في تليجرام.
# اتركه فارغاً إن لم ترد البوت — يُتخطّى نشره كله.
TELEGRAM_OWNER_ID=

# سرّ الـwebhook. اتركه فارغاً وسيولّده السكربت لك عشوائياً ويضبطه
# في Supabase وفي تليجرام معاً — لن تحتاج رؤيته أبداً.
TELEGRAM_WEBHOOK_SECRET=
