# انسخ هذا الملف إلى .env.deploy وعبّئه. الأصل بلا أسرار، والنسخة
# مستثناة في .gitignore ولا تدخل git أبداً.

# من رابط مشروعك: https://supabase.com/dashboard/project/XXXXXXXX
SUPABASE_PROJECT_REF=

# عنوان متجرك بالضبط، بلا شرطة في آخره. هذا وحده ما تقبله الدوال.
SITE_URL=https://janeiro-store.com

# اختياري — إشعار تيليغرام بكل طلب جديد. اتركهما فارغين إن لم ترده بعد.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
